# ─── Required ───────────────────────────────────────────────────────────────
# PostgreSQL connection string. On Render this comes from the database automatically.
DATABASE_URL=postgresql://firstfive:firstfive@localhost:54320/firstfive
# Random string, at least 32 characters. Signs nothing client-side; used to hash
# invitation codes. On Render it is generated automatically (generateValue).
SESSION_SECRET=replace-with-a-long-random-string-of-at-least-32-chars

# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Public base URL. On Render, RENDER_EXTERNAL_URL is used automatically when unset.
APP_URL=http://localhost:3000
# Local Vite dev server origin (development only).
DEV_WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ─── First Five SDK (built in a SEPARATE project) ───────────────────────────
# Public URL of the hosted SDK bundle. Unset ⇒ installation snippets are labeled
# as a setup preview. Example: https://sdk.firstfive.app/v1/firstfive.js
SDK_SCRIPT_URL=

# ─── Access & pricing ───────────────────────────────────────────────────────
# One ₹99 purchase = one study credit (one website, one journey, up to 5 testers).
PAID_STUDY_PRICE_MINOR=9900
PAID_STUDY_CURRENCY=INR
PAID_STUDY_CREDITS=1
PAID_PARTICIPANT_CAP=5
# Checkout opens ONLY when true AND the Pine Labs adapter is implemented + configured.
# Keep false until the full study (SDK + AI report) can actually be delivered.
PAYMENTS_ENABLED=false
# Default allowance for invitation codes (each code can override).
DEFAULT_CODE_STUDY_CREDITS=1
DEFAULT_CODE_PARTICIPANT_CAP=5
MAX_DRAFT_STUDIES=10

# ─── Retention & scheduling ─────────────────────────────────────────────────
EVENT_RETENTION_DAYS=30
OUTBOX_RETENTION_DAYS=14
SWEEP_INTERVAL_SECONDS=60
ANALYTICS_SNAPSHOT_TTL_SECONDS=300
DISABLE_SCHEDULER=false

# ─── PostHog Cloud (future — docs/integrations/POSTHOG_SETUP.md) ────────────
POSTHOG_HOST=
POSTHOG_API_HOST=
POSTHOG_PROJECT_API_KEY=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# ─── AgenticOrg UX Director (future — docs/integrations/AGENTICORG_SETUP.md) ─
AGENTICORG_BASE_URL=
AGENTICORG_API_KEY=
AGENTICORG_WORKFLOW_ID=
AGENTICORG_WEBHOOK_SECRET=

# ─── Pine Labs (future — docs/integrations/PINELABS_SETUP.md) ───────────────
PINELABS_ENV=uat
PINELABS_BASE_URL=
PINELABS_CLIENT_ID=
PINELABS_CLIENT_SECRET=
PINELABS_MERCHANT_ID=
PINELABS_WEBHOOK_SECRET=
